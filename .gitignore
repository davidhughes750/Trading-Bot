# ==============================================================================
# Trading 212 Quantitative Bot - Git Ignore Rules
# ==============================================================================

# Secrets and environment configurations
.env
.env.local
.env.*.local
*.env
!.env.example

# Python virtual environment
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Pytest & testing cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Logs and runtime generated state files
logs/*.log
logs/*.json
!logs/.gitkeep

# macOS filesystem metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Temporary deployment bundles
*.tar.gz
/tmp/t212_bot_bundle.tar.gz

# IDE / Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~
