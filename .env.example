# ============================================================================
# 1. TRADING 212 ENVIRONMENT & API CREDENTIALS
# ============================================================================
# Execution Mode:
#   - demo  : Trading 212 Practice / Paper Trading API (https://demo.trading212.com/api/v0)
#   - paper : Local offline/online simulator (no Trading 212 API key needed)
#   - live  : Trading 212 Real Money API (https://live.trading212.com/api/v0)
EXECUTION_MODE=demo
LIVE_TRADING_CONFIRMED=false

# Trading 212 API Credentials (generate in Trading 212 App -> Settings -> API (Beta))
T212_API_KEY=your_t212_api_key_here
T212_API_SECRET=your_t212_api_secret_here

# Optional explicit base URL override (auto-selected from EXECUTION_MODE if blank)
T212_BASE_URL=

# Local 'paper' mode virtual settings
PAPER_INITIAL_EQUITY=10000.0
PAPER_FEE_RATE=0.000

# ============================================================================
# 2. STOCK SCREENER & RECOMMENDATION ENGINE
# ============================================================================
# When ENABLE_SCREENER=true, the bot scans 25 liquid Trading 212 stocks on every
# closed candle, ranks them from 0 to 100, prints a Top Recommendations table,
# and automatically trades the #1 highest-scoring pick (when TRADE_TOP_RECOMMENDATION=true).
ENABLE_SCREENER=true
TRADE_TOP_RECOMMENDATION=true
MIN_RECOMMENDATION_SCORE=70.0
SCREENER_TOP_N=10

# Optional custom screener universe override (leave blank to scan the built-in 25 top US stocks)
SCREENER_UNIVERSE=

# Core priority watchlist symbols (High-Beta Momentum core watchlist)
SYMBOLS=PLTR_US_EQ,COIN_US_EQ,TSLA_US_EQ,AMD_US_EQ,NVDA_US_EQ
TIMEFRAME=15m
OHLCV_LIMIT=200

# Technical Indicator Parameters
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50
RSI_PERIOD=14
ATR_PERIOD=14
RSI_LONG_THRESHOLD=50.0
RSI_SHORT_THRESHOLD=50.0

# Trading 212 Invest / Stocks ISA accounts are Long-Only (cannot short sell)
ALLOW_SHORT=false

# Exit & Trailing Stop Multipliers (in ATR units - wider to overcome 0.30% round-trip T212 FX fee)
TAKE_PROFIT_ATR_MULT=3.5
STOP_LOSS_ATR_MULT=2.0
TRAILING_STOP_ENABLED=true
TRAILING_STOP_ACTIVATE_R=1.0
TRAILING_STOP_ATR_MULT=1.5

# Sniper Entry Quality & Anti-Whipsaw Filters
MIN_RVOL_FOR_ENTRY=1.0
MAX_EMA_EXTENSION_ATR=1.6
COOLDOWN_MINUTES_AFTER_LOSS=120
MARKET_REGIME_FILTER=true
MARKET_BENCHMARK_SYMBOL=QQQ
SKIP_OPENING_MINUTES=15
MIN_HOLD_MINUTES_FOR_ROTATION=45

# ============================================================================
# 3. RISK MANAGEMENT & EXECUTION RULES
# ============================================================================
# Risk 1.5% (0.015) of total account equity per trade based on stop distance
RISK_PER_TRADE_PCT=0.015

# Maximum concurrent open positions across all symbols (3 concentrated slots, max 33% equity per stock)
MAX_OPEN_POSITIONS=3
MAX_POSITION_EXPOSURE_PCT=0.33

# Hard Circuit Breaker: halt trading if equity drops > 5% (0.05) within a rolling 24h window
MAX_DAILY_DRAWDOWN_PCT=0.05

# Slippage & Spread Guard: reject order if (ask - bid) / mid > 0.15% (0.0015)
MAX_SPREAD_PCT=0.0015

# Order type for entries ('limit' or 'market') and Trading 212 timeValidity ('DAY' or 'GOOD_TILL_CANCEL')
ENTRY_ORDER_TYPE=limit
T212_TIME_VALIDITY=DAY
FRACTIONAL_DECIMALS=4
ORDER_FILL_TIMEOUT_SEC=15

# ============================================================================
# 4. AI PORTFOLIO MANAGER (GOOGLE GEMINI + LIVE NEWS CATALYST FILTER)
# ============================================================================
ENABLE_AI_MANAGER=true
# Optional free key from https://aistudio.google.com/apikey (uses built-in Quant News Engine if blank)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_SLOT_ROTATION_ENABLED=true
AI_DECISIONS_FILE=logs/ai_decisions.json

# ============================================================================
# 5. RUNTIME & LOGGING
# ============================================================================
POLL_INTERVAL_SEC=15
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log
STATE_FILE=logs/t212_state.json

# ============================================================================
# 6. TELEGRAM MOBILE NOTIFICATIONS & REMOTE CONTROL
# ============================================================================
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
